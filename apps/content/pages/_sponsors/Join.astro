---
import Icon from 'blume/components/Icon.astro'
import { advertiseHref } from '../../sponsors/ads'
import { GITHUB_SPONSORS_URL, OPEN_COLLECTIVE_URL } from '../../sponsors/data'
---

<section id="join" class="relative isolate overflow-hidden border-b border-border">
  <div aria-hidden="true" class="orpc-dots orpc-dots-bottom"></div>

  <div class="relative mx-auto max-w-6xl px-6 py-24 text-center sm:py-32">
    <h2 class="font-display mx-auto max-w-2xl text-3xl font-semibold tracking-[-0.035em] text-balance sm:text-5xl">
      Help fund what comes next.
    </h2>
    <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-balance text-muted-foreground">
      Any amount helps. Every active sponsor appears in the table above, on the home page, and
      in the README.
    </p>

    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <a class="orpc-btn orpc-btn-primary" href={GITHUB_SPONSORS_URL} rel="noopener" target="_blank">
        <Icon name="heart" size={15} />
        Sponsor on GitHub
      </a>
      <a class="orpc-btn orpc-btn-ghost" href={OPEN_COLLECTIVE_URL} rel="noopener" target="_blank">
        <Icon name="hand-coins" size={15} />
        Open Collective
      </a>
    </div>

    <p class="mt-8 text-sm text-balance text-muted-foreground">
      Selling to developers? Ad slots in the docs are sold one at a time.{' '}
      <a
        class="underline underline-offset-4 transition-colors hover:text-foreground"
        href={advertiseHref()}>Ask about a slot</a
      >.
    </p>
  </div>
</section>
